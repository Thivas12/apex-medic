# Optional: copy to .env.local. The defaults need no cloud credentials.
# Process environment variables override values in .env.local.
APEX_DATABASE_BACKEND=sqlite
APEX_LLM_PROVIDER=ollama

# Cloud database: set APEX_DATABASE_BACKEND=postgres, then supply your own values.
# DATABASE_URL=<pooled PostgreSQL URL with TLS>
# DATABASE_URL_UNPOOLED=<matching direct URL; migration command only>

# Cloud model: set APEX_LLM_PROVIDER=groq, then supply your own key.
# GROQ_API_KEY=<your private Groq key>

# Hosting reads this from the PROCESS environment, not from this file.
# Render defaults to its RENDER_EXTERNAL_URL; local Uvicorn uses 127.0.0.1:8000.
# APEX_PUBLIC_ORIGIN=https://your-service.onrender.com
